{
  "name": "@cinatra-ai/image-artifact",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "@cinatra-ai/sdk-extensions": "*",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@cinatra-ai/sdk-extensions": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^3.0.0"
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "artifact",
    "displayName": "Image",
    "vendor": {
      "key": "cinatra-ai",
      "name": "Cinatra"
    },
    "dependencies": [],
    "artifact": {
      "accepts": {
        "file": {
          "mimeTypes": [
            "image/*"
          ]
        }
      },
      "ui": {
        "abiVersion": 1,
        "sdkAbiRange": "^2.5.0",
        "renderers": {
          "detail": {
            "entry": "./src/renderers/detail.tsx",
            "propsApiVersion": 2,
            "representations": [
              "image/*"
            ]
          },
          "preview": {
            "entry": "./src/renderers/preview.tsx",
            "propsApiVersion": 2,
            "representations": [
              "image/*"
            ]
          }
        }
      },
      "objectTypes": [
        {
          "type": "@cinatra-ai/image-artifact:image",
          "claim": "dedicated",
          "dispositions": {
            "projection": "artifact-safe",
            "pinnable": true,
            "snapshotPolicy": "content",
            "sensitivity": "normal",
            "mutability": "record"
          },
          "schema": {
            "type": "object",
            "properties": {
              "artifactType": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "mime": {
                "type": "string"
              },
              "size": {
                "type": "integer"
              },
              "originKind": {
                "type": "string"
              },
              "viewerHint": {
                "type": "string"
              },
              "latestRepresentationRevisionId": {
                "type": "string"
              },
              "latestDigest": {
                "type": "string"
              }
            },
            "required": [
              "mime",
              "size",
              "latestRepresentationRevisionId"
            ],
            "additionalProperties": true
          }
        }
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/renderers/detail": {
      "import": "./src/renderers/detail.tsx",
      "default": "./src/renderers/detail.tsx"
    },
    "./src/renderers/preview": {
      "import": "./src/renderers/preview.tsx",
      "default": "./src/renderers/preview.tsx"
    }
  }
}
